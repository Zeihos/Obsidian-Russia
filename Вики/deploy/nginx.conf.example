# Example reverse proxy. Replace hostname and certificate paths.
# Make sure port 8100 binds only to 127.0.0.1.
server {
    listen 80;
    server_name wiki.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name wiki.example.com;
    ssl_certificate /etc/letsencrypt/live/wiki.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wiki.example.com/privkey.pem;
    client_max_body_size 4m;
    add_header X-Content-Type-Options nosniff always;
    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }
    location = /login { limit_req zone=wiki_login burst=5 nodelay; proxy_pass http://127.0.0.1:8100; }
}
# Define 'limit_req_zone $binary_remote_addr zone=wiki_login:10m rate=10r/m;'
# inside the Nginx http{} context before using the above configuration.
