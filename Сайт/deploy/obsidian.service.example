# Example systemd unit for a dedicated non-root Linux user `obsidian`.
# Save as /etc/systemd/system/obsidian.service and adapt the paths.
[Unit]
Description=OBSIDIAN RUSSIA web portal
After=network.target
[Service]
Type=simple
User=obsidian
Group=obsidian
WorkingDirectory=/opt/obsidian-russia
Environment=OBSIDIAN_BIND=127.0.0.1
Environment=OBSIDIAN_PORT=8080
Environment=OBSIDIAN_SECURE_COOKIES=1
Environment=OBSIDIAN_TRUST_PROXY=1
Environment=OBSIDIAN_BASE_URL=https://obsidian.example.com
Environment=OBSIDIAN_DATA_DIR=/var/lib/obsidian-russia
ExecStart=/usr/bin/python3 /opt/obsidian-russia/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/obsidian-russia
[Install]
WantedBy=multi-user.target
