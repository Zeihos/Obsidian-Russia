# Example reverse proxy for the standalone forum. HTTPS/TLS certificate required.
# Update forum.example.org, cert paths, and server_name before use.
server {
    listen 80;
    server_name forum.example.org;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name forum.example.org;
    ssl_certificate     /etc/letsencrypt/live/forum.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forum.example.org/privkey.pem;
    client_max_body_size 256k;
    add_header Strict-Transport-Security 'max-age=31536000; includeSubDomains' always;
    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
