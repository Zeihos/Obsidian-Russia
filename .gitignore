# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local application state. Never publish accounts, sessions or SQLite journals.
**/data/
.runtime/
**/static/uploads/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3-journal

# Secrets and machine-generated files
.env
.env.*
!.env.example
*.log
*.pem
*.key
id_rsa*
id_ed25519*
.DS_Store
Thumbs.db
